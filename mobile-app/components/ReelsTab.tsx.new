import { useCallback, useMemo, useState } from "react";
import {
  ActivityIndicator,
  Dimensions,
  FlatList,
  Image,
  Modal,
  Pressable,
  RefreshControl,
  Text,
  View,
} from "react-native";
import { WebView } from "react-native-webview";
import { Film, PlayCircle, X } from "lucide-react-native";

import { useCollection } from "../src/lib/useFirestore";
import type { Reel } from "../../shared/types";

/**
 * Reels tab — vertical list of poster cards. Tapping a reel opens a
 * full-screen modal that plays the video inline using a WebView wrapping
 * an HTML5 <video> tag.
 */
export function ReelsTab() {
  const { data, loading, error, refresh } = useCollection<Reel>("reels", {
    orderByField: "order",
    orderDir: "asc",
    limit: 100,
  });

  const [refreshing, setRefreshing] = useState(false);
  const [active, setActive] = useState<Reel | null>(null);

  const onRefresh = useCallback(async () => {
    setRefreshing(true);
    try {
      await refresh();
    } finally {
      setRefreshing(false);
    }
  }, [refresh]);

  if (loading && !data) {
    return (
      <View className="mt-16 items-center">
        <ActivityIndicator color="#B8336A" />
        <Text className="mt-3 text-sm text-zinc-500">Loading reels…</Text>
      </View>
    );
  }
  if (error && !data) {
    return (
      <Text className="mt-6 text-sm text-red-500">
        Could not load: {error.message}
      </Text>
    );
  }
  if (!data || data.length === 0) {
    return (
      <View className="mt-16 items-center">
        <Film color="#9CA3AF" size={28} />
        <Text className="mt-3 text-sm italic text-zinc-500">
          No reels yet.
        </Text>
      </View>
    );
  }

  return (
    <>
      <FlatList
        data={data}
        keyExtractor={(item) => item.id}
        showsVerticalScrollIndicator={false}
        contentContainerStyle={{ paddingTop: 12, paddingBottom: 120 }}
        refreshControl={
          <RefreshControl
            refreshing={refreshing}
            onRefresh={onRefresh}
            tintColor="#B8336A"
            colors={["#B8336A", "#F4A261"]}
          />
        }
        renderItem={({ item }) => (
          <Pressable
            onPress={() => setActive(item)}
            className="mb-3 overflow-hidden rounded-2xl border border-primary/10 bg-white active:opacity-90"
          >
            <View className="relative aspect-[9/16] w-full bg-black">
              {item.thumbnailUrl ? (
                <Image
                  source={{ uri: item.thumbnailUrl }}
                  className="h-full w-full"
                  resizeMode="cover"
                />
              ) : (
                <View className="h-full w-full items-center justify-center">
                  <Film color="#fff" size={36} />
                </View>
              )}
              <View className="absolute inset-0 items-center justify-center bg-black/20">
                <PlayCircle color="#fff" size={56} />
              </View>
            </View>

            {(item.title || item.caption) && (
              <View className="p-3">
                {item.title ? (
                  <Text
                    className="text-sm font-semibold text-zinc-900"
                    numberOfLines={1}
                  >
                    {item.title}
                  </Text>
                ) : null}
                {item.caption ? (
                  <Text
                    className="mt-0.5 text-xs text-zinc-500"
                    numberOfLines={2}
                  >
                    {item.caption}
                  </Text>
                ) : null}
              </View>
            )}
          </Pressable>
        )}
      />

      <ReelPlayer reel={active} onClose={() => setActive(null)} />
    </>
  );
}

/* ----------------------------------------------------------- */

function ReelPlayer({
  reel,
  onClose,
}: {
  reel: Reel | null;
  onClose: () => void;
}) {
  const { width, height } = Dimensions.get("window");

  const html = useMemo(() => {
    if (!reel) return "";
    return buildHtml(reel);
  }, [reel]);

  return (
    <Modal
      visible={!!reel}
      animationType="fade"
      transparent
      statusBarTranslucent
      onRequestClose={onClose}
    >
      <View className="flex-1 bg-black">
        {reel ? (
          <WebView
            originWhitelist={["*"]}
            source={{ html }}
            allowsInlineMediaPlayback
            mediaPlaybackRequiresUserAction={false}
            javaScriptEnabled
            domStorageEnabled
            allowsFullscreenVideo
            style={{ flex: 1, backgroundColor: "#000" }}
          />
        ) : null}

        <Pressable
          onPress={onClose}
          hitSlop={12}
          className="absolute right-4 top-12 h-10 w-10 items-center justify-center rounded-full bg-white/15 active:opacity-70"
        >
          <X color="#fff" size={22} />
        </Pressable>

        {(reel?.title || reel?.caption) && (
          <View
            className="absolute left-0 right-0 px-5"
            style={{ bottom: Math.max(24, height * 0.06) }}
            pointerEvents="none"
          >
            {reel?.title ? (
              <Text
                className="text-base font-bold text-white"
                style={{ textShadowColor: "rgba(0,0,0,0.6)", textShadowRadius: 4 }}
                numberOfLines={2}
              >
                {reel.title}
              </Text>
            ) : null}
            {reel?.caption ? (
              <Text
                className="mt-1 text-xs text-white/90"
                style={{ textShadowColor: "rgba(0,0,0,0.6)", textShadowRadius: 3 }}
                numberOfLines={3}
              >
                {reel.caption}
              </Text>
            ) : null}
          </View>
        )}

        {/* Suppress unused warning for width */}
        <View style={{ width: 0, height: 0 }} pointerEvents="none" />
      </View>
    </Modal>
  );
}

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

function buildHtml(reel: Reel): string {
  const poster = reel.thumbnailUrl
    ? `poster="${escapeHtml(reel.thumbnailUrl)}"`
    : "";

  return `<!doctype html>
<html>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no" />
<style>
  html, body {
    margin: 0; padding: 0;
    height: 100%; width: 100%;
    background: #000; color: #fff;
    overflow: hidden;
  }
  .wrap {
    position: fixed; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: #000;
  }
  video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }
  .hint {
    position: absolute;
    top: 16px; left: 16px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    background: rgba(255,255,255,0.18);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .hint.hidden { display: none; }
</style>
</head>
<body>
  <div class="wrap">
    <video
      id="v"
      src="${escapeHtml(reel.videoUrl)}"
      ${poster}
      playsinline
      webkit-playsinline
      preload="auto"
      loop
      autoplay
      muted
    ></video>
    <div class="hint" id="hint">Tap to unmute</div>
  </div>
<script>
  const v = document.getElementById('v');
  const hint = document.getElementById('hint');

  function tryPlay() {
    const p = v.play();
    if (p && p.catch) p.catch(() => {});
  }

  document.addEventListener('click', () => {
    if (v.muted) {
      v.muted = false;
      v.volume = 1.0;
      hint.classList.add('hidden');
      tryPlay();
    } else if (v.paused) {
      tryPlay();
    } else {
      v.pause();
    }
  });

  window.addEventListener('load', tryPlay);
</script>
</body>
</html>`;
}
